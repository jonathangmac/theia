# ===========================
# Theia — .gitignore
# ===========================

# Secrets — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project data — runtime artifacts
data/
frames/
*.jpg
*.png
*.mp4
*.ts
!tests/fixtures/**

# Logs
logs/
*.log

# Docker
docker-compose.override.yml

# OS
Thumbs.db
