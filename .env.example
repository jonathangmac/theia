# ===========================
# Theia Configuration
# ===========================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# --- Inference Provider ---
# TensorX (EU sovereign, OpenAI-compatible)
TENSORX_API_KEY=your-key-here
# Alternative: direct Moonshot
# MOONSHOT_API_KEY=your-key-here

# --- Model Settings ---
THEIA_VLM_MODEL=moonshotai/kimi-k3
THEIA_VLM_BASE_URL=https://api.tensorx.ai/v1
THEIA_VLM_REASONING_EFFORT=low
THEIA_VLM_MAX_TOKENS=2000

# --- Pipeline Settings ---
THEIA_CAPTURE_INTERVAL=15
THEIA_HISTORY_SIZE=10
THEIA_GATE_THRESHOLD=15
THEIA_MAX_FRAMES=0

# --- Stream Sources ---
# Comma-separated YouTube/RTSP URLs
THEIA_STREAMS=https://youtu.be/3nyPER2kzqk

# --- Storage (optional) ---
THEIA_DB_URL=sqlite+aiosqlite:///data/theia.db

# --- Alerting (optional) ---
THEIA_SLACK_WEBHOOK=
THEIA_ALERT_EMAIL=
